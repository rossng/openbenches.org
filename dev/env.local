# Symfony .env.local for the Docker setup in compose.yaml. Every third-party key is a
# dummy value, so features that need them (maps, OCR, geocoding, login) won't work.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET="local-e2e-not-secret"
DATABASE_URL="mysqli://openbenches:badpassword@db:3306/openbenc_benches?charset=utf8mb4"
CACHE=""

NAME="OpenBenches (local)"
DOMAIN="http://localhost:8000/"

AUTH0_DOMAIN="auth.invalid"
AUTH0_CLIENT_ID="local-e2e"
AUTH0_CLIENT_SECRET="local-e2e"
AUTH0_ANDROID_CLIENT_ID="local-e2e-android"
AUTH0_ANDROID_CLIENT_SECRET="local-e2e-android"

CLOUDINARY_KEY="dummy"
THUNDERFOREST_API_KEY="dummy"
ESRI_API_KEY="dummy"
ARCGIS_KEY="dummy"
CLOUD_VISION_KEY="dummy"
OPENCAGE_API_KEY="dummy"
GEOAPIFY_API_KEY="dummy"
GEOCODE_API_KEY="dummy"
STADIAMAPS_API_KEY="dummy"
FACEBOOK_APP_ID="dummy"
FLICKR_API_KEY="dummy"

# Leave empty so uploads don't try to send mail.
NOTIFICATION_EMAIL=""
ADMIN_USERIDS=""

# Empty means images are served from this server rather than images.weserv.nl.
IMAGE_CACHE_PREFIX=""
IMAGE_CACHE_QUALITY="60"
IMAGE_DEFAULT_SIZE="600"
IMAGE_THUMB_SIZE="120"
